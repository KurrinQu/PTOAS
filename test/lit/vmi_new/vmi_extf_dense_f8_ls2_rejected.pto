// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto 2>&1 | FileCheck %s

// A dense 8-bit extf with a lane-stride source and deinterleaved result has
// physical arity factor 2, which stock (and PR 1459) reject for dense bytes:
// sub-byte part selection would read the zero-fill gap lanes of the
// unpack-style distribution.  If this test ever starts passing, the dense
// factor-4 guard has been weakened and the e4m3 regression can come back.

module {
  func.func @dense_f8_ls2_to_f32_d2_rejected(
      %x: !pto.vmi.vreg<128xf8E4M3FN, #pto.vmi.layout<contiguous, lane_stride = 2>>)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> {
    %r = pto.vmi.vcvt %x
        : !pto.vmi.vreg<128xf8E4M3FN, #pto.vmi.layout<contiguous, lane_stride = 2>>
       -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
    return %r : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
  }
}

// CHECK: VMI-RESIDUAL-OP
